{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "node .cursor/hooks/guard.mjs beforeShellExecution",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "beforeReadFile": [
      {
        "command": "node .cursor/hooks/guard.mjs beforeReadFile",
        "timeout": 10,
        "failClosed": false
      }
    ],
    "preToolUse": [
      {
        "command": "node .cursor/hooks/guard.mjs preToolUse",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "afterFileEdit": [
      {
        "command": "node .cursor/hooks/guard.mjs afterFileEdit",
        "timeout": 10,
        "failClosed": false
      }
    ],
    "stop": [
      {
        "command": "node .cursor/hooks/validate.mjs",
        "timeout": 120,
        "failClosed": false
      }
    ]
  }
}
